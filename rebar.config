%% -*- erlang -*-
{minimum_otp_vsn, "22.0"}.

{deps,
 [{lager, {git, "https://github.com/erlang-lager/lager.git", {branch, "develop-3.0"}}},
  {poolboy, {git, "https://github.com/basho/poolboy.git", {tag, "riak_kv-3.0.0"}}},
  {riak_sysmon, {git, "https://github.com/basho/riak_sysmon.git", {tag, "2.2.0"}}},
  {clique, {git, "https://github.com/basho/clique.git", {tag, "0.3.11"}}},
  {eleveldb, {git, "https://github.com/TI-Tokyo/eleveldb.git", {branch, "riak_ts-develop-3.0"}}},
  {riak_ensemble, {git, "https://github.com/TI-Tokyo/riak_ensemble", {branch, "riak_ts-develop-3.0"}}},
  {pbkdf2, {git, "https://github.com/basho/erlang-pbkdf2.git", {tag, "2.1.0"}}},
  {cluster_info, {git, "https://github.com/basho/cluster_info.git", {tag, "2.1.0"}}},
  {exometer_core, {git, "https://github.com/Feuerlabs/exometer_core.git", {tag, "v1.5.7"}}},
  {basho_stats, {git, "https://github.com/basho/basho_stats.git", {tag, "1.1.0"}}},
  {jam, {git, "https://github.com/TI-Tokyo/jam.git", {branch, "riak_ts-develop-3.0"}}}
]}.

{plugins,
 [{eqc_rebar, {git, "https://github.com/Quviq/eqc-rebar", {branch, "master"}}}
 ]
}.

{erl_first_files,
 ["src/gen_nb_server.erl",
  "src/riak_core_gen_server.erl",
  "src/riak_core_stat_xform"
 ]
}.

{erl_opts,
 [warnings_as_errors,
  {parse_transform, lager_transform}
 ]
}.

{eunit_opts, [verbose]}.

{xref_checks, [undefined_function_calls, undefined_functions, locals_not_used]}.

{cover_enabled, true}.

{profiles,
 [{test, [{deps, [meck]}, {erl_opts, [nowarn_export_all]}]},
  {eqc, [{deps, [meck]}, {erl_opts, [{d, 'EQC'}, nowarn_export_all]}]},
  {gha, [{erl_opts, [{d, 'GITHUBEXCLUDE'}]}]}
 ]
}.
