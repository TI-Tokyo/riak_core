%% -*- erlang -*-
{minimum_otp_vsn, "22.0"}.

{erl_opts, [warnings_as_errors, debug_info]}.

{deps, [
  {exometer_core, "1.6.1"},
  {poolboy, {git, "https://github.com/basho/poolboy.git", {tag, "riak_kv-3.0.0"}}},
  {pbkdf2, {git, "https://github.com/basho/erlang-pbkdf2.git", {branch, "master"}}},
  {cluster_info, {git, "https://github.com/basho/cluster_info.git", {tag, "2.1.0"}}},
  {basho_stats, {git, "https://github.com/basho/basho_stats.git", {tag, "1.1.0"}}},

  %% deps with TS-specific changes, or required by TS
  {riak_sysmon, {git, "https://github.com/TI-Tokyo/riak_sysmon.git", {tag, "riak_ts-3.0.0"}}},
  {clique, {git, "https://github.com/TI-Tokyo/clique.git", {tag, "riak_ts-3.0.0"}}},
  {eleveldb, {git, "https://github.com/TI-Tokyo/eleveldb.git", {tag, "riak_ts-3.0.1rc2"}}},
  {riak_ensemble, {git, "https://github.com/TI-Tokyo/riak_ensemble", {tag, "riak_ts-3.0.0"}}},
  {jam, {git, "https://github.com/TI-Tokyo/jam.git", {tag, "3.0.0"}}}
]}.

{plugins,
 [{eqc_rebar, {git, "https://github.com/Quviq/eqc-rebar", {branch, "master"}}}
 ]
}.

{erl_first_files,
 ["src/gen_nb_server.erl",
  "src/riak_core_gen_server.erl",
  "src/riak_core_stat_xform"
 ]
}.

{edoc_opts, [{preprocess, true}]}.

{eunit_opts, [verbose]}.

{xref_checks, [undefined_function_calls,undefined_functions,locals_not_used]}.

{profiles,
 [{test, [{deps, [meck, proper]}, {erl_opts, [nowarn_export_all]}]},
  {gha, [{erl_opts, [{d, 'GITHUBEXCLUDE'}]}]}
 ]
}.
